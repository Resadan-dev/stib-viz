{
  "name": "stib-viz-web",
  "version": "0.1.0",
  "private": true,
  "description": "stib-viz website: a night-time animation of STIB traffic in Brussels.",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Resadan-dev/stib-viz.git",
    "directory": "web"
  },
  "dependencies": {
    "@deck.gl/core": "9.4.1",
    "@deck.gl/geo-layers": "9.4.1",
    "@deck.gl/layers": "9.4.1",
    "@deck.gl/mapbox": "9.4.1",
    "maplibre-gl": "6.16.0"
  },
  "pnpm": {
    "overrides": {
      "fflate": "^0.7.5"
    }
  }
}
